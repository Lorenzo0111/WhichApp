{
  "expo": {
    "scheme": "whichapp",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "output": "static"
    },
    "name": "WhichApp",
    "slug": "whichapp",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow $(PRODUCT_NAME) to access your Face ID biometric data."
        }
      ]
    ],
    "android": {
      "package": "me.lorenzo0111.whichapp"
    },
    "ios": {
      "bundleIdentifier": "me.lorenzo0111.whichapp",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Allow $(PRODUCT_NAME) to access your local network."
      }
    }
  }
}
